<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- SPICE projects are authored with their own solution directory as an include root.
       When consumed from SKEWER.sln, preserve that contract without modifying the submodule. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)SPICE;$(MSBuildThisFileDirectory)SPICE\SpiceModeling;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
